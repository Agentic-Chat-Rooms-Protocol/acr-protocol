{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ACR Agent Card",
  "type": "object",
  "required": [
    "did",
    "name",
    "role",
    "status",
    "capabilities"
  ],
  "properties": {
    "did": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:.+$"
    },
    "name": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "agent",
        "human",
        "sentinel"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "online",
        "offline",
        "deliberating",
        "busy"
      ]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}